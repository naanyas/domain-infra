# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
POSTGRES_DB=domain_infra
POSTGRES_USER=domain_infra
POSTGRES_PASSWORD=domain_infra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# "require" for Neon / most managed Postgres; "prefer" for local dev.
POSTGRES_SSLMODE=prefer

# Phase 2 enrichment vendor API keys
IPQS_API_KEY=            # IPQualityScore — IP reputation (VPN/proxy/Tor/datacenter/geo/ASN)
# EMAILABLE_API_KEY=     # Email validity + disposable detection
# HIBP_API_KEY=          # HaveIBeenPwned — breach lookups
# MAXMIND_LICENSE_KEY=   # GeoLite2 IP geolocation (free tier alternative to IPQS for geo only)
# TWILIO_ACCOUNT_SID=    # Twilio Lookup — phone validation
# TWILIO_AUTH_TOKEN=
# VIRUSTOTAL_API_KEY=    # Already used by vendored SDAT analyzer if present
